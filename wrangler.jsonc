{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-11-03",
  "name": "script-worker",
  "main": "src/index.js",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true },
    "traces": { "enabled": true }
  },
  "assets": {
    "directory": "./scripts",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
